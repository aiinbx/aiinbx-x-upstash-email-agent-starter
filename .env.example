# AI Inbx API key (console → API keys). Set it before `npm run setup`.
AI_INBX_API_KEY=
# The webhook's signing secret. `npm run setup` fills in the one `aiinbx listen` uses.
AI_INBX_WEBHOOK_SECRET=

# Upstash Redis, Vector and Blob. `npm run setup` creates them and fills these in.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
UPSTASH_BLOB_TOKEN=

# Upstash Workflow. Locally QSTASH_DEV=true runs a QStash dev server, no keys needed.
QSTASH_DEV=true
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=

# Set it, and `npm run dev` runs the example agent, which writes draft replies.
# ANTHROPIC_API_KEY=

# The inbox the dev server's MCP endpoint and the e2e script act as.
AGENT_INBOX=agent@your-slug.aiinbx.app

# npm run e2e: a second AI Inbx workspace that mails the agent.
# E2E_SENDER_API_KEY=
# E2E_SENDER_FROM="Anna <anna@other-slug.aiinbx.app>"
